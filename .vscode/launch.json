        },
        {
            "name": "Annotate / label projection",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/annotate.py",
            "args": ["--scene", "${input:scene}"],
            "cwd": "${workspaceFolder}",
            "python": "/home/sebastian-hafner/miniconda3/envs/ai4onboardsar/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
